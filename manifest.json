{
  "manifest_version": 3,
  "name": "Gmail Shortcuts",
  "version": "1.9.0",
  "description": "Fast, non-invasive keyboard shortcuts for Gmail Snooze (auto-activates when Snooze menu opens).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
