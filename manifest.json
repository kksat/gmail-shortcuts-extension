{
  "manifest_version": 3,
  "name": "Shortcuts for Gmail: Snooze, Search & Navigate",
  "version": "1.0.0",
  "description": "One-key Gmail snooze, search by sender or subject, jump to unread — extra shortcuts that stay out of your way.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
