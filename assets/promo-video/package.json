{
  "name": "promo-video",
  "version": "1.0.0",
  "description": "40-second product overview for Shortcuts for Gmail",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/media": "4.0.547",
    "@remotion/transitions": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "npm run soundtrack && remotion studio",
    "soundtrack": "node scripts/generate-audio.mjs",
    "render": "npm run soundtrack && remotion render src/index.ts ShortcutsForGmail out/shortcuts-for-gmail-promo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster": "remotion still src/index.ts ShortcutsForGmail out/poster.png --frame=1080",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
